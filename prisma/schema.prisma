
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id                String             @id @default(cuid())
  fullName          String
  phoneNumber       String             @unique
  email             String?            @unique
  passwordHash      String
   wallet            Wallet?
  role              UserRole           @default(CUSTOMER)
  phoneVerifiedAt   DateTime?
  phoneVerifications PhoneVerification[]
  identityVerifications IdentityVerification[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PhoneVerification {
  id          String   @id @default(cuid())
  userId      String
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}
enum DataType {
  SME
  GIFTING
  CORPORATE_GIFTING
}
enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletFundingStatus {
  PENDING
  CONFIRMED
  FAILED
  REVIEW_REQUIRED
}

enum IdentityType {
  NIN
  BVN
}

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REVIEW_REQUIRED
}

enum VirtualAccountStatus {
  ACTIVE
  INACTIVE
}

model Network {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String        @unique
  isActive  Boolean       @default(true)
  bundles   DataBundle[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model DataBundle {
  id             String               @id @default(cuid())
  networkId      String
  dataType       DataType
  name           String
  dataAmountMb   Int
  validityDays   Int
  sellingPriceKobo Int
  isActive       Boolean              @default(true)
  network        Network              @relation(fields: [networkId], references: [id], onDelete: Restrict)
  supplierProducts SupplierProduct[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([networkId, dataType, isActive])
  @@unique([networkId, dataType, name])
}

model Supplier {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String            @unique
  isActive  Boolean           @default(true)
  products  SupplierProduct[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model SupplierProduct {
  id                String     @id @default(cuid())
  dataBundleId      String
  supplierId        String
  supplierProductId String
  costPriceKobo     Int
  isAvailable       Boolean    @default(true)
  dataBundle        DataBundle @relation(fields: [dataBundleId], references: [id], onDelete: Restrict)
  supplier          Supplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([supplierId, supplierProductId])
  @@unique([dataBundleId, supplierId])
  @@index([dataBundleId, isAvailable])
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balanceKobo Int      @default(0)

  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  virtualAccounts  VirtualAccount[]
  fundings         WalletFunding[]
  transactions     WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VirtualAccount {
  id                String               @id @default(cuid())
  walletId          String
  providerCode      String
  providerAccountId String
  accountNumber     String
  bankName          String
  accountName       String
  status            VirtualAccountStatus @default(ACTIVE)

  wallet   Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  fundings WalletFunding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerCode, providerAccountId])
  @@unique([providerCode, accountNumber])
  @@index([walletId, status])
}

model WalletFunding {
  id                    String              @id @default(cuid())
  walletId              String
  virtualAccountId      String
  providerCode          String
  providerReference     String              @unique
  providerTransactionId String?
  expectedAmountKobo    Int?
  receivedAmountKobo    Int?
  currency              String              @default("NGN")
  status                WalletFundingStatus @default(PENDING)
  confirmedAt           DateTime?

  wallet           Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  virtualAccount   VirtualAccount     @relation(fields: [virtualAccountId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerCode, providerTransactionId])
  @@index([walletId, status])
  @@index([createdAt])
}

model WalletTransaction {
  id                  String                @id @default(cuid())
  walletId            String
  fundingId           String?               @unique
  reference           String                @unique
  type                WalletTransactionType
  amountKobo          Int
  balanceBeforeKobo   Int
  balanceAfterKobo    Int
  description         String

  wallet  Wallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  funding WalletFunding? @relation(fields: [fundingId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}
model IdentityVerification {
  id                String                     @id @default(cuid())
  userId            String
  identityType      IdentityType
  status            IdentityVerificationStatus @default(PENDING)

  providerCode      String
  providerReference String?                    @unique

  verifiedAt        DateTime?
  failureCode       String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, identityType])
}
